# ---- Supabase (from Supabase dashboard > Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---- Slack (from your Slack Incoming Webhook) ----
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ---- Cron protection (make up a long random string) ----
CRON_SECRET=make-a-long-random-string-here

# ---- Your deployed site URL (set after first Vercel deploy) ----
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
